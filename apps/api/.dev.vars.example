# API Development Secrets
# Copy this file to .dev.vars and fill in your values
# This file is for local development only and should not be committed

# Better Auth Secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=local-dev-secret-key-change-in-production

# Stripe Secret Key (test mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe Webhook Secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key

# Resend API Key
RESEND_API_KEY=re_your_resend_api_key

# OAuth Providers (optional, for testing login)
# AUTH_GOOGLE_ID=your_google_client_id
# AUTH_GOOGLE_SECRET=your_google_client_secret
# AUTH_GITHUB_ID=your_github_client_id
# AUTH_GITHUB_SECRET=your_github_client_secret
