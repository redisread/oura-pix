{
  "name": "@oura-pix/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply oura-pix-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply oura-pix-db --remote",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@oura-pix/types": "workspace:*",
    "drizzle-orm": "^0.45.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.31.9",
    "typescript": "^5.6.3",
    "wrangler": "^4.69.0"
  }
}
