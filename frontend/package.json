{
  "name": "@oura-pix/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm i18n:build && astro dev",
    "build": "pnpm i18n:build && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src/",
    "clean": "rm -rf dist .astro",
    "typecheck": "pnpm i18n:build && tsc --noEmit",
    "i18n:build": "paraglide-js compile --project ../packages/i18n/project.inlang --outdir ./src/paraglide --strategy url cookie baseLocale --emit-ts-declarations --silent",
    "i18n:check": "pnpm --filter @oura-pix/i18n check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/react": "^5.0.7",
    "@imgly/background-removal": "^1.7.0",
    "@oura-pix/api-client": "workspace:*",
    "@oura-pix/i18n": "workspace:*",
    "astro": "^6.4.8",
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "onnxruntime-web": "1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "web-vitals": "^5.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260625.1",
    "@eslint/js": "^9.0.0",
    "@inlang/paraglide-js": "^2.18.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.0.0",
    "wrangler": "^4.105.0"
  }
}
